---
/** Aero's document shell owns product metadata, light chrome, and global styles. */
import aeroFaviconUrl from "@/assets/favicon.svg?url";
import "@/styles/site.css";
import montserratLatinUrl from "@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  canonical: string;
}

const SITE = "https://aerobrowser.app";
const SITE_DESCRIPTION =
  "A small, fast browser for macOS, built with AppKit and WebKit.";
const { title, description = SITE_DESCRIPTION, canonical } = Astro.props;
const fullTitle = title ? `${title} | Aero Browser` : "Aero Browser";
const montserratFontFace = `
  @font-face {
    font-family: "Montserrat Variable";
    src: url("${montserratLatinUrl}") format("woff2-variations");
    font-display: block;
    font-style: normal;
    font-weight: 100 900;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC,
      U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
      U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content="Aero Browser" />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:url" content={SITE} />
    <meta property="og:site_name" content="Aero" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Aero Browser" />
    <meta name="twitter:description" content={SITE_DESCRIPTION} />
    <link rel="icon" href={aeroFaviconUrl} type="image/svg+xml" />
    <link
      rel="preload"
      href={montserratLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <style is:inline set:html={montserratFontFace}></style>
    <slot name="head" />
  </head>
  <body>
    <a class="aero-skip-link" href="#main">
      {" "}
      Skip to content{" "}
    </a>
    <slot />
  </body>
</html>

<style is:global>
  /* Match aro.computer's Montserrat metrics when a glyph falls back to Arial. */
  @font-face {
    font-family: "Montserrat Fallback";
    src: local("Arial");
    ascent-override: 85.79%;
    descent-override: 22.25%;
    line-gap-override: 0%;
    size-adjust: 112.83%;
  }
</style>
